# Copy to .env (gitignored) for local development. None of these are required to run `npm start`:
# every one degrades gracefully when unset.

# MongoDB connection string for player progress. Bloxity Legion injects it per game+channel when
# deployed; unset locally = no persistence (progress lasts the connection only).
MONGODB_URI=

# CORS allow-origin. Injected when deployed; falls back to "*" locally.
CLIENT_ORIGIN=

# HTTP port (Legion injects it). Falls back to 2567.
PORT=2567

# Injected by Bloxity hosting (leave unset locally): leaderboards, token verify and Open Rooms.
# BLOXITY_GAME_ID=shoot-a-bullet
# BLOXITY_REPORT_TOKEN=
# BLOXITY_API_URL=https://api.bloxity.io
# MATCHMAKER_REPORT_URL=
